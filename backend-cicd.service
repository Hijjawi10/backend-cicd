[Unit]
Description=Backend CI/CD Demo
After=network.target

[Service]
Type=simple
User=jenkins
Group=jenkins
WorkingDirectory=/opt/backend-cicd
ExecStart=/opt/backend-cicd/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target