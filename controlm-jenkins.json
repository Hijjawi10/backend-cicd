{
    "FDS_Jenkins": {
        "Type": "Folder",
        "ControlmServer": "IN01",
        "SiteStandard": "FDS",
        "Application": "FDS",
        "SubApplication": "Jenkins",
        "BusinessFields": [
            {
                "Partner code": "FDS"
            }
        ],
        "FDS_Deploy_Backend": {
            "Type": "Job:Jenkins",
            "Host": "fds-hijjawi",
            "Application": "FDS",
            "SubApplication": "Jenkins",
            "ConnectionProfile": "FDS_JENKINS",
            "Pipeline Name": "backend-cicd-v2",
            "Add Parameters": "unchecked",
            "Add Branch Name": "unchecked",
            "Fetch Console Logs": "checked",
            "Status Polling Frequency": "20",
            "Failure Tolerance": "2"
        },
        "FDS_Verify_Backend": {
            "Type": "Job:Command",
            "Host": "fds-hijjawi",
            "RunAs": "hijjawi10",
            "Application": "FDS",
            "SubApplication": "Jenkins",
            "Description": "Verify deployed backend health and version",
            "Command": "python3 -c 'import json, urllib.request; data=json.load(urllib.request.urlopen(\"http://127.0.0.1:8001/health\", timeout=5)); assert data[\"status\"]==\"ok\", data; assert data[\"version\"]==\"1.1.0\", data; print(\"Backend verified:\", data)'"
        },
        "FDS_Backup_DB": {
            "Type": "Job:Command",
            "Host": "fds-hijjawi",
            "RunAs": "hijjawi10",
            "Application": "FDS",
            "SubApplication": "Jenkins",
            "Description": "Backup SQLite and validate backup integrity",
            "Command": "python3 /home/hijjawi10/Desktop/backend-cicd/backup_database.py --run-id '%%$SMART_ORDERID'"
        },
        "FDS_Backend_SLA": {
            "Type": "Job:SLAManagement",
            "Application": "FDS",
            "SubApplication": "Jenkins",
            "Host": "fds-hijjawi",
            "RunAs": "hijjawi10",
            "ServiceName": "FDS_Backend_Deployment",
            "ServicePriority": "2",
            "JobRunsDeviationsTolerance": "2",
            "CompleteIn": {
                "Time": "00:05"
            },
            "ServiceActions": {
                "FDS_If_Expected_Late": {
                    "Type": "If:SLA:ServiceIsLate",
                    "FDS_Notify_Expected_Late": {
                        "Type": "Action:SLA:Notify",
                        "Severity": "Urgent",
                        "Message": "FDS Backend deployment is expected to miss its SLA."
                    }
                },
                "FDS_If_Deadline_Passed": {
                    "Type": "If:SLA:ServiceLatePastDeadline",
                    "FDS_Notify_Deadline_Passed": {
                        "Type": "Action:SLA:Notify",
                        "Severity": "VeryUrgent",
                        "Message": "FDS Backend deployment exceeded its 5 minute SLA."
                    }
                },
                "FDS_If_Job_Failed": {
                    "Type": "If:SLA:JobFailureOnServicePath",
                    "FDS_Notify_Job_Failed": {
                        "Type": "Action:SLA:Notify",
                        "Severity": "Urgent",
                        "Message": "FDS Backend deployment has a failed job on its SLA path."
                    }
                }
            }
        },
        "FDS_Collect_Logs": {
            "Type": "Job:Command",
            "Host": "fds-hijjawi",
            "RunAs": "hijjawi10",
            "Application": "FDS",
            "SubApplication": "Jenkins",
            "Description": "Collect workflow logs on success failure or timeout",
            "Command": "python3 /home/hijjawi10/Desktop/backend-cicd/collect_workflow_logs.py --folder-id 'IN01:%%$SMART_ORDERID' --timeout-minutes 15"
        },
        "FDS_Deploy_Then_Verify": {
            "Type": "Flow",
            "Sequence": [
                "FDS_Backup_DB",
                "FDS_Deploy_Backend",
                "FDS_Verify_Backend",
                "FDS_Backend_SLA"
            ]
        }
    }
}